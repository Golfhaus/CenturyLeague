{
  "name": "century-league",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc -p packages/simulation-core/tsconfig.json --noEmit && tsc -p apps/player-registry/tsconfig.json --noEmit",
    "build:core": "tsc -p packages/simulation-core/tsconfig.json",
    "build:registry": "npm run build:core && npm run build --workspace=@century-league/player-registry",
    "validate:generator": "npm run build:core && node scripts/validate-generator.mjs",
    "validate:lifecycle": "npm run build:core && node scripts/validate-monthly-lifecycle.mjs",
    "validate:pool": "npm run build:core && node scripts/validate-pool-lifecycle.mjs",
    "validate:players": "npm run build:core && node scripts/validate-player-factory.mjs",
    "validate:edge-mirror": "node scripts/validate-edge-mirror.mjs",
    "validate:matches": "npm run build:core && node scripts/validate-matches.mjs",
    "simulate:exhibitions": "npm run build:core && node scripts/run-exhibitions.mjs",
    "analyze:matches": "npm run build:core && node scripts/analyze-match-variation.mjs",
    "audit:matches": "npm run build:core && node scripts/audit-match-engine.mjs",
    "sample:club": "npm run build:core && node scripts/analyze-club-opponents.mjs",
    "sample:league": "npm run build:core && node scripts/analyze-league-balance.mjs",
    "probe:roster-repair": "npm run build:core && node scripts/probe-roster-repair.mjs",
    "check:styles": "npm run build:core && node scripts/check-style-viability.mjs",
    "simulate:round": "npm run build:core && node scripts/run-exhibition-round.mjs",
    "verify:match-baseline": "npm run build:core && node scripts/verify-match-baseline.mjs",
    "validate:competition": "npm run build:core && node scripts/validate-competition.mjs",
    "competition": "npm run build:core && node scripts/manage-competition.mjs",
    "rehearse:competition": "npm run build:core && node scripts/rehearse-competition-round.mjs",
    "prepare:draft-import": "npm run build:core && node scripts/prepare-draft-import.mjs",
    "prepare:roster-import": "npm run build:core && node scripts/prepare-founding-roster-import.mjs",
    "validate:roster-import": "npm run build:core && node scripts/validate-roster-import.mjs",
    "validate:competition-db": "npm run build:core && node scripts/sync-match-edge.mjs --check && node --experimental-transform-types scripts/validate-competition-database.mjs",
    "sync:match-edge": "node scripts/sync-match-edge.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.14",
    "pg": "8.23.1",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
