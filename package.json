{
  "name": "century-league",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc -p packages/simulation-core/tsconfig.json --noEmit && tsc -p apps/player-registry/tsconfig.json --noEmit",
    "build:core": "tsc -p packages/simulation-core/tsconfig.json",
    "build:registry": "npm run build:core && npm run build --workspace=@century-league/player-registry",
    "validate:generator": "npm run build:core && node scripts/validate-generator.mjs",
    "validate:lifecycle": "npm run build:core && node scripts/validate-monthly-lifecycle.mjs",
    "validate:pool": "npm run build:core && node scripts/validate-pool-lifecycle.mjs"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
